---
import { sitePath } from '../utils/site-path';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
const directions = [
  { number: '01', title: 'Vehicles for sale', description: 'Explore the MSD Autos vehicle listings.', action: 'Explore vehicles', href: sitePath('/cars/'), image: sitePath('/brand/hero-coupe.jpg'), icon: 'car', tone: 'sales' },
  { number: '02', title: 'Vehicle rental', description: 'Ask the team about rental availability and details.', action: 'Explore rental', href: sitePath('/rental/'), image: sitePath('/brand/rental-sedan.jpg'), icon: 'key', tone: 'rental' },
  { number: '03', title: 'Automotive service', description: 'Get in touch with MSD Autos about automotive service.', action: 'Explore service', href: sitePath('/service/'), image: sitePath('/brand/service-workshop.jpg'), icon: 'wrench', tone: 'service' },
];
---
<SiteLayout title="MSD Autos | Your next move" description="Vehicles for sale, rental enquiries and automotive service from MSD Autos." minimal>
  <div class="bio-page">
    <section class="bio-hero" aria-labelledby="bio-title">
      <div class="bio-hero__image" aria-hidden="true"></div><div class="bio-hero__veil" aria-hidden="true"></div>
      <div class="bio-hero__content"><p class="bio-kicker"><span></span> MSD AUTOS · TORREVIEJA</p><h1 id="bio-title">Your next move<br/><em>starts here.</em></h1><p class="bio-hero__lead">Vehicles for sale, rental enquiries and automotive service. Choose a direction to get started.</p><a class="bio-hero__hint" href="#directions">Explore MSD Autos <span aria-hidden="true">↓</span></a></div>
      <div class="bio-hero__index" aria-hidden="true">MSD<br/>AUTOS</div>
    </section>
    <section class="bio-directions" id="directions" aria-labelledby="directions-title">
      <div class="bio-section-heading"><div><p class="bio-eyebrow">Choose your direction</p><h2 id="directions-title">How can we help?</h2></div><span class="bio-section-heading__count">01 — 03</span></div>
      <div class="bio-cards">
        {directions.map((direction) => (
          <a class:list={["bio-card", `bio-card--${direction.tone}`]} href={direction.href}>
            <span class="bio-card__image"><img src={direction.image} alt="" loading="lazy"/><span class="bio-card__number">{direction.number}</span></span>
            <span class="bio-card__copy"><span class="bio-card__icon"><Icon name={direction.icon} size={22}/></span><span class="bio-card__text"><strong>{direction.title}</strong><span>{direction.description}</span><span class="bio-card__action">{direction.action}<span aria-hidden="true">↗</span></span></span></span>
          </a>
        ))}
      </div>
    </section>
    <footer class="bio-footer"><div><p class="bio-eyebrow">Need a hand?</p><p class="bio-footer__copy">Talk to the MSD Autos team.</p></div><a class="bio-footer__contact" href={sitePath('/contact/')}>Contact MSD Autos <span aria-hidden="true">↗</span></a><a class="bio-footer__phone" href="tel:+34604400244">+34 604 40 02 44</a></footer>
  </div>
</SiteLayout>

<style>
  .bio-header{position:relative;z-index:2;background:#fff;border-bottom:1px solid #ececec}.bio-header__inner{width:min(1080px,calc(100% - 48px));min-height:76px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}.bio-header .brand__signature{display:none}.bio-header .brand img{width:42px;height:42px}.bio-header .language-switch select{min-width:60px}
  .bio-page{--bio-red:#e11b22;--bio-ink:#1f1f1f;--bio-muted:#666;max-width:1080px;margin:0 auto;padding:28px 24px 24px}.bio-hero{position:relative;isolation:isolate;min-height:350px;display:flex;align-items:center;overflow:hidden;border-radius:8px;background:#171717;color:#fff}.bio-hero__image,.bio-hero__veil{position:absolute;inset:0;z-index:-1}.bio-hero__image{background:url('../assets/hero-coupe.jpg') center 57%/cover no-repeat;transform:scale(1.01)}.bio-hero__veil{background:linear-gradient(90deg,#111 0%,#111f 37%,#111b 64%,#1115 100%),linear-gradient(0deg,#1118,transparent 55%)}.bio-hero__content{max-width:670px;padding:48px clamp(28px,6vw,68px)}.bio-kicker,.bio-eyebrow{margin:0;color:#ff5b60;font-size:10px;font-weight:700;letter-spacing:.19em;text-transform:uppercase}.bio-kicker{display:flex;align-items:center;gap:10px;margin-bottom:17px}.bio-kicker span{width:7px;height:7px;border-radius:50%;background:var(--bio-red);box-shadow:0 0 0 5px #e11b2228}.bio-hero h1{margin:0 0 16px;font-size:clamp(42px,6.5vw,66px);line-height:.98;letter-spacing:-.065em}.bio-hero h1 em{color:#ff4b51;font-style:normal}.bio-hero__lead{max-width:485px;margin:0;color:#e2e2e2;font-size:14px;line-height:1.7}.bio-hero__hint{display:inline-flex;align-items:center;gap:14px;margin-top:22px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.bio-hero__hint span{color:#ff5559;font-size:18px;transition:transform .18s}.bio-hero__hint:hover span{transform:translateY(3px)}.bio-hero__index{position:absolute;right:34px;bottom:28px;color:#ffffff68;font-size:9px;font-weight:700;line-height:1.3;letter-spacing:.22em;text-align:right}
  .bio-directions{padding:38px 2px 36px}.bio-section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:18px}.bio-eyebrow{color:var(--bio-red)}.bio-section-heading h2{margin:7px 0 0;font-size:clamp(24px,3.4vw,32px);letter-spacing:-.045em}.bio-section-heading__count{padding-bottom:4px;color:#888;font-size:10px;font-weight:700;letter-spacing:.13em}.bio-cards{display:grid;gap:10px}.bio-card{min-height:112px;display:grid;grid-template-columns:160px minmax(0,1fr);border:1px solid #e5e5e5;border-radius:7px;background:#fff;overflow:hidden;transition:border-color .2s,transform .2s,box-shadow .2s}.bio-card:hover{transform:translateY(-2px);border-color:#c9c9c9;box-shadow:0 12px 26px #1111110d}.bio-card__image{position:relative;min-height:112px;background:#222;overflow:hidden}.bio-card__image:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#1111,#1116)}.bio-card__image img{width:100%;height:100%;min-height:112px;position:absolute;inset:0;object-fit:cover;transition:transform .35s}.bio-card:hover .bio-card__image img{transform:scale(1.045)}.bio-card__number{position:absolute;z-index:1;top:10px;left:12px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.12em}.bio-card__copy{display:flex;align-items:center;gap:16px;padding:15px 20px}.bio-card__icon{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border-radius:50%;background:#f5f5f5;color:var(--bio-red)}.bio-card__text{min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:14px;row-gap:2px}.bio-card__text strong{font-size:15px;line-height:1.35}.bio-card__text>span:nth-child(2){grid-column:1;color:var(--bio-muted);font-size:11px;line-height:1.5}.bio-card__action{grid-column:2;grid-row:1/3;display:flex;align-items:center;gap:11px;color:var(--bio-red);font-size:9px;font-weight:700;letter-spacing:.08em;text-align:right;text-transform:uppercase}.bio-card__action span{font-size:17px;transition:transform .18s}.bio-card:hover .bio-card__action span{transform:translate(2px,-2px)}
  .bio-footer{min-height:65px;padding:13px 3px 0;border-top:1px solid #e7e7e7;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:26px}.bio-footer .bio-eyebrow{font-size:9px}.bio-footer__copy{margin:1px 0 0;font-size:12px;font-weight:600}.bio-footer__contact{display:inline-flex;align-items:center;gap:12px;color:var(--bio-red);font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.bio-footer__contact span{font-size:15px}.bio-footer__phone{font-size:11px;font-weight:700;white-space:nowrap}
  @media(max-width:620px){.bio-header__inner{width:calc(100% - 36px);min-height:66px}.bio-header .brand img{width:37px;height:37px}.bio-page{padding:16px 16px 20px}.bio-hero{min-height:340px;border-radius:6px}.bio-hero__image{background-position:61% center}.bio-hero__veil{background:linear-gradient(90deg,#111e 0%,#111c 58%,#1118 100%),linear-gradient(0deg,#1118,transparent 52%)}.bio-hero__content{padding:36px 24px}.bio-hero h1{font-size:clamp(42px,12vw,58px)}.bio-hero__lead{max-width:345px;font-size:13px}.bio-hero__index{right:18px;bottom:17px}.bio-directions{padding:29px 0 26px}.bio-section-heading{margin-bottom:14px}.bio-card{min-height:106px;grid-template-columns:104px minmax(0,1fr)}.bio-card__image,.bio-card__image img{min-height:106px}.bio-card__copy{gap:11px;padding:12px 12px}.bio-card__icon{width:32px;height:32px;flex-basis:32px}.bio-card__icon svg{width:18px;height:18px}.bio-card__text{grid-template-columns:minmax(0,1fr) auto;column-gap:6px}.bio-card__text strong{font-size:12px}.bio-card__text>span:nth-child(2){font-size:10px}.bio-card__action{font-size:0;gap:0}.bio-card__action span{font-size:17px}.bio-footer{grid-template-columns:1fr auto;gap:8px 16px}.bio-footer__contact{grid-column:2;grid-row:1}.bio-footer__phone{grid-column:1/-1;padding-top:7px;border-top:1px solid #eee;font-size:10px}}
  @media(prefers-reduced-motion:reduce){.bio-card,.bio-card__image img,.bio-hero__hint span,.bio-card__action span{transition:none}.bio-card:hover{transform:none}.bio-card:hover .bio-card__image img{transform:none}}
</style>
