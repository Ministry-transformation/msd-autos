---
import { sitePath } from '../utils/site-path';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import VehicleCard from '../components/VehicleCard.astro';
import { vehicles } from '../data/vehicles';
---
<SiteLayout title="MSD Autos | Vehicles, rental and service" description="Explore vehicles, rental and automotive service with MSD Autos." active="/">
  <section class="hero"><div class="wrap hero__inner"><div class="hero__copy"><p class="eyebrow">MSD Autos · Driven by confidence</p><h1>Find your<br/><em>next drive.</em></h1><p class="lead">Start with a vehicle. Explore rental and automotive service when you need them.</p><div class="hero__actions"><a class="btn" href={sitePath('/cars/')}>Explore vehicles <span class="arrow">→</span></a><a class="btn btn--light" href={sitePath('/contact/?topic=vehicles')}>Ask about a car <span class="arrow">→</span></a></div></div></div></section>
  <div class="proof-strip"><div class="wrap proof-strip__items"><span><Icon name="car" size={24}/><span>Vehicles for sale</span></span><span><Icon name="key" size={24}/><span>Vehicle rental</span></span><span><Icon name="wrench" size={24}/><span>Automotive service</span></span><span><Icon name="shield" size={24}/><span>Contact MSD Autos</span></span></div></div>
  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">First · Vehicles for sale</p><h2>Cars from MSD Autos.</h2></div><a class="btn btn--outline" href={sitePath('/cars/')}>Browse featured cars <span class="arrow">→</span></a></div><div class="vehicle-grid vehicle-grid--home">{vehicles.map(vehicle => <VehicleCard vehicle={vehicle} />)}</div><p class="catalog-source-note">Six featured listings from MSD Autos. Availability and prices can change; confirm on each original advert.</p><a class="btn home-inventory-link" href="https://www.milanuncios.com/tiendas-profesionales/msd-autos-222741?utm_medium=social-media&utm_source=general&utm_campaign=send_friend-profile" target="_blank" rel="noopener noreferrer">See all cars for sale <span class="arrow">↗</span></a></div></section>
  <section class="section section--soft pattern"><div class="wrap"><div class="section-head"><div><p class="eyebrow">More from MSD Autos</p><h2>What brings you here?</h2></div><p>Explore rental and service, or talk to MSD Autos about what you need.</p></div><div class="grid grid--3"><ServiceCard icon="key" title="Rental" description="Ask about rental availability and details." href={sitePath('/rental/')} linkText="Explore rental"/><ServiceCard icon="wrench" title="Service" description="Contact MSD Autos with an automotive service enquiry." href={sitePath('/service/')} linkText="Explore service"/><ServiceCard icon="phone" title="Talk to us" description="Choose a topic and send an enquiry." href={sitePath('/contact/')} linkText="Contact MSD Autos"/></div></div></section>
  <section class="section"><div class="wrap location-spotlight"><div><p class="eyebrow">Visit MSD Autos</p><h2>Torrevieja, Alicante.</h2><p>Av. de las Habaneras, 101 · 03182 Torrevieja</p><a class="btn btn--dark" href="https://www.google.com/maps/search/?api=1&query=MSD+Autos+Av.+de+las+Habaneras+101+03182+Torrevieja" target="_blank" rel="noopener noreferrer">Get directions <span class="arrow">↗</span></a></div><a class="location-spotlight__phone" href="tel:+34604400244"><span>Call MSD Autos</span><strong>+34 604 40 02 44</strong></a></div></section>
</SiteLayout>
