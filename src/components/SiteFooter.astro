---
import { sitePath } from '../utils/site-path';
import BrandLockup from './BrandLockup.astro';
---
<footer class="site-footer"><div class="wrap"><div class="footer-top"><div class="footer-brand"><BrandLockup/><p>Vehicles, rental and automotive service. Find the right next step with MSD Autos.</p><a class="footer-contact" href="tel:+34604400244">MSD Autos · +34 604 40 02 44</a><span class="footer-contact">Av. de las Habaneras, 101 · Torrevieja</span><a class="footer-contact" href="https://www.instagram.com/msd.autos/" target="_blank" rel="noopener noreferrer">Instagram @msd.autos ↗</a></div><div class="footer-links"><div><strong>Explore</strong><a href={sitePath('/cars/')}>Vehicles</a><a href={sitePath('/rental/')}>Rental</a><a href={sitePath('/service/')}>Service</a></div><div><strong>Get in touch</strong><a href={sitePath('/contact/')}>Contact & locations</a><a href="https://www.milanuncios.com/tiendas-profesionales/msd-autos-222741?utm_medium=social-media&utm_source=general&utm_campaign=send_friend-profile" target="_blank" rel="noopener noreferrer">All cars for sale · Milanuncios ↗</a><a href="https://www.coches.net/concesionario/msdautos/" target="_blank" rel="noopener noreferrer">Also on Coches.net ↗</a></div></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} MSD Autos</span><span>Driven by confidence</span><a class="footer-developer" data-no-translate href="https://ministry-transformation.github.io/" aria-label="Developed by the Ministry of Transformation" target="_blank" rel="noopener noreferrer">Developed by the Ministry of Transformation</a></div></div></footer>
<script>
  const developerCredits: Record<string, string> = {
    uk: 'Розроблено Міністерством трансформації',
    ru: 'Разработано Министерством трансформации',
    es: 'Desarrollado por el Ministerio de Transformación',
    en: 'Developed by the Ministry of Transformation',
  };
  document.addEventListener('DOMContentLoaded', () => {
    const link = document.querySelector<HTMLAnchorElement>('.footer-developer');
    if (!link) return;
    const label = developerCredits[document.documentElement.lang] ?? developerCredits.en;
    link.textContent = label;
    link.setAttribute('aria-label', label);
  }, { once: true });
</script>
