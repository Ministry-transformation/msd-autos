---
import { sitePath } from '../utils/site-path';
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="Design System | MSD Autos" description="MSD Autos visual design system and reusable interface components.">
  <section class="page-hero"><div class="wrap"><p class="eyebrow">MSD Autos</p><h1>Design system.</h1><p class="lead">Reusable foundations and interface components for the MSD Autos website.</p></div></section>
  <section class="section"><div class="wrap"><p class="eyebrow">01 · Brand colors</p><h2>Color palette</h2><div class="grid grid--3" style="margin-top:25px"><div><div class="ds-swatch" style="background:#E11B22"></div><strong>MSD Red</strong><div class="muted">#E11B22 · Primary action</div></div><div><div class="ds-swatch" style="background:#1F1F1F"></div><strong>Charcoal Black</strong><div class="muted">#1F1F1F · Text and dark panels</div></div><div><div class="ds-swatch" style="background:#F4F4F4;border:1px solid #eee"></div><strong>Light Gray</strong><div class="muted">#F4F4F4 · Soft surfaces</div></div><div><div class="ds-swatch" style="background:#A0A0A0"></div><strong>Mid Gray</strong><div class="muted">#A0A0A0 · Supporting neutral</div></div><div><div class="ds-swatch" style="background:#fff;border:1px solid #ddd"></div><strong>Pure White</strong><div class="muted">#FFFFFF · Main surface</div></div></div></div></section>
  <section class="section section--soft"><div class="wrap"><p class="eyebrow">02 · Typography</p><h2>Montserrat type scale</h2><div class="grid grid--3" style="margin-top:25px"><div class="ds-type"><p class="label">H1 · 48–64 px / 800</p><h1 style="font-size:40px">Driven by confidence</h1></div><div class="ds-type"><p class="label">H2 · 24–32 px / 700</p><h2>Premium automotive</h2></div><div class="ds-type"><p class="label">Body · 16–18 px / 400</p><p>Clear, comfortable reading with muted supporting copy.</p><p class="label">Caption · 11–12 px / 700</p></div></div></div></section>
  <section class="section"><div class="wrap"><p class="eyebrow">03 · Buttons and links</p><h2>Action hierarchy</h2><div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin:25px 0 52px"><Button href={sitePath('/cars/')}>Explore vehicles</Button><Button href={sitePath('/rental/')} variant="dark">Rental enquiry</Button><Button href={sitePath('/service/')} variant="outline">Service details</Button><span style="display:inline-flex;padding:8px;border-radius:6px;background:#1f1f1f"><Button href={sitePath('/contact/')} variant="light">Contact us</Button></span></div><p class="eyebrow">04 · Icons</p><div style="display:flex;gap:35px;flex-wrap:wrap;margin-top:20px"><div><Icon name="car" size={32}/><span class="label">Vehicles</span></div><div><Icon name="key" size={32}/><span class="label">Rental</span></div><div><Icon name="wrench" size={32}/><span class="label">Service</span></div><div><Icon name="shield" size={32}/><span class="label">Trust</span></div></div></div></section>
  <section class="section section--soft pattern"><div class="wrap"><p class="eyebrow">05 · Cards and patterns</p><h2>Reusable content cards</h2><div class="grid grid--3" style="margin-top:25px"><ServiceCard icon="car" title="Vehicles" description="Ask about current vehicle availability." href={sitePath('/cars/')}/><ServiceCard icon="key" title="Rental" description="Contact MSD Autos with your enquiry." href={sitePath('/rental/')}/><ServiceCard icon="wrench" title="Service" description="Ask the team about automotive service." href={sitePath('/service/')}/></div></div></section>
  <section class="section"><div class="wrap split"><div><p class="eyebrow">06 · Spacing and responsive behavior</p><h2>Space for clarity.</h2><p class="lead">A 1240 px content maximum, fluid 76–124 px section rhythm and 13–28 px component gaps keep layouts readable across screen sizes.</p></div><div class="form-card"><div class="label">Input field · 50 px minimum</div><div class="field" style="margin-top:10px"><label for="example">Example input</label><input id="example" placeholder="Your name"/></div><p class="form-foot">Layouts stack to a single column on small screens. Motion respects reduced-motion preferences.</p></div></div></section>
</SiteLayout>
